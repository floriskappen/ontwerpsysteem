        "upstreamVersion": "Version 2.000 (google/fonts commit a85fc09e44c70c7159761adfdc9d5dd007792c15)",
        "tooling": "fonttools 4.63.0",
        "commands": [
          "fonttools varLib.instancer 'Caveat[wght].ttf' wght=500:700 -o Caveat-wght500-700.ttf",
