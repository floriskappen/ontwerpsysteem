{
  "$description": "Canonical face definitions for every shipped font binary. Single source of truth: BOTH @font-face flavours — the base64-inlined rules in the zoo HTML and the relative-URL rules in values/css/fonts.css — are generated from this file, so they can never drift. `weight` is the DECLARED @font-face range; validation (Gate B) verifies it is contained in the binary's real weight-axis coverage read from the woff2 itself, and Gate A verifies every fontWeight token falls inside the tokenBound face's range.",
  "faces": [
    {
      "family": "Archivo",
      "file": "archivo-latin.woff2",
      "style": "normal",
      "weight": { "min": 400, "max": 700 },
      "tokenBound": true,
      "provenance": {
        "license": "OFL-1.1",
        "sourceUrl": "https://raw.githubusercontent.com/google/fonts/6c70c829f09ea345d3590406693220ea35c6553f/ofl/archivo/Archivo%5Bwdth%2Cwght%5D.ttf",
        "upstreamVersion": "Version 2.001 (google/fonts commit 6c70c829f09ea345d3590406693220ea35c6553f)",
        "tooling": "fonttools 4.63.0",
        "commands": [
          "fonttools varLib.instancer 'Archivo[wdth,wght].ttf' wght=400:700 wdth=100 -o Archivo-wght400-700.ttf",
          "pyftsubset Archivo-wght400-700.ttf --output-file=archivo-latin.woff2 --flavor=woff2 --unicodes=U+000D,U+0020-007E,U+00A0-00FF,U+0102,U+0131,U+0152-0153,U+02BC,U+02C6,U+02DA,U+02DC,U+0300-0301,U+0303-0304,U+0308-0309,U+0323,U+2009,U+2013-2014,U+2018-201A,U+201C-201E,U+2022,U+2026,U+2032-2033,U+2039-203A,U+2044,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF"
        ]
      }
    },
    {
      "family": "JetBrains Mono",
      "file": "jetbrains-mono-latin.woff2",
